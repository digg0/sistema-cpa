ENVIRONMENT=development
SECRET_KEY=altere-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Banco de dados — PostgreSQL é o motor padrão (ver docker-compose.yml / docker-compose.dev.yml).
# Formato: postgresql+psycopg2://<usuario>:<senha>@<host>:5432/<banco>
DATABASE_URL=postgresql+psycopg2://cpa:altere-esta-senha@localhost:5432/cpa
# Alternativa apenas para rodar o backend fora de Docker sem subir Postgres local:
# DATABASE_URL=sqlite:///./data/cpa.db

# Usadas pelo serviço "db" do Docker Compose para inicializar o Postgres
POSTGRES_USER=cpa
POSTGRES_PASSWORD=altere-esta-senha
POSTGRES_DB=cpa

CORS_ORIGINS=http://localhost:5173,http://localhost:80
